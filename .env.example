# Copy to .env and fill in. Never commit the real file.
#   cp .env.example .env && chmod 600 .env

# --- Mail.ru (IMAP over TLS) ---
MAIL_HOST=imap.mail.ru
MAIL_PORT=993
MAIL_USERNAME=example@mail.ru
# Use a Mail.ru application password, not the account password.
MAIL_PASSWORD=
MAIL_FOLDER=INBOX

# --- Telegram ---
# From @BotFather.
TELEGRAM_BOT_TOKEN=
# Group chat id, usually negative (e.g. -1001234567890).
TELEGRAM_CHAT_ID=

# --- Local state ---
DATABASE_PATH=./data/mailbridge.db

# CRITICAL, ERROR, WARNING, INFO, DEBUG
LOG_LEVEL=INFO
